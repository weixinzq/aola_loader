<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>AolaSocketHack</AssemblyName>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AolaSocketHack.Contracts\AolaSocketHack.Contracts.csproj" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <Reference Include="EasyHook">
      <HintPath>$(OriginalBinaryDirectory)EasyHook.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
