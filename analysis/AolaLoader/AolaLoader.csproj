<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <AssemblyName>AolaLoader</AssemblyName>
    <RootNamespace>AolaLoader</RootNamespace>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AutoGenerateBindingRedirects>True</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>True</GenerateBindingRedirectsOutputType>
  </PropertyGroup>
  <ItemGroup>
	<Content Include="Resources\Themes\*.swf">
	  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	</Content>
    <PackageReference Include="CefSharp.WinForms" Version="87.1.132" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <Reference Include="System.Management" />
    <Reference Include="System.Runtime.Remoting" />
    <Reference Include="EasyHook">
      <HintPath>$(OriginalBinaryDirectory)EasyHook.dll</HintPath>
    </Reference>
    <ProjectReference Include="..\AolaSocketHack.Contracts\AolaSocketHack.Contracts.csproj" />
    <ProjectReference Include="..\AolaSocketHack\AolaSocketHack.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\runtime\pepflashplayer.dll">
      <Link>runtime\pepflashplayer.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\runtime\EasyHook32.dll;..\runtime\EasyHook64.dll;..\runtime\EasyHook32Svc.exe;..\runtime\EasyHook64Svc.exe;..\runtime\EasyLoad32.dll;..\runtime\EasyLoad64.dll">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
