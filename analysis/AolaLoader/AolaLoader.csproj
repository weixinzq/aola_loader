<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <AssemblyName>AolaLoader</AssemblyName>
    <RootNamespace>AolaLoader</RootNamespace>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <LangVersion>latest</LangVersion>
    <AutoGenerateBindingRedirects>True</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>True</GenerateBindingRedirectsOutputType>
  </PropertyGroup>
  <ItemGroup>
	<Content Include="Resources\Themes\*.swf">
	  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	</Content>
	<Content Include="Resources\Data\pet-poster-catalog.json">
	  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	</Content>
	<Content Include="Resources\Data\battle-pet-movie-versions.current.json">
	  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	</Content>
	<Content Include="Resources\BattleAssistant\**\*;Resources\Data\battle-assistant-assets.json">
		<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	</Content>
	<Content Include="Resources\Patches\start-bridge-2107300001.fws.swf">
	  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	</Content>
	<Content Include="Resources\Patches\petfightnew-battle-state-current.fws.swf">
	  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	</Content>
	<Content Include="Resources\Patches\petfightnew-battle-cinematics-2026091780747880-v4.fws.swf">
	  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	</Content>
	<Content Include="Resources\Patches\petfightnew-battle-visual-260929024751831.fws.swf">
	  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	</Content>
	<Content Include="Resources\Battle\background.jpg">
	  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	</Content>
	<Content Include="Resources\Patches\petfightnew-battle-state.current.json">
	  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	</Content>
	<Content Include="Resources\Patches\newpetpackage-morph-20260919895706432-visual-v3.fws.swf">
	  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	</Content>
    <PackageReference Include="CefSharp.WinForms" Version="87.1.132" />
    <PackageReference Include="EasyHook" Version="2.7.7097" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
	<PackageReference Include="SharpCompress" Version="0.50.4" />
    <Reference Include="System.Management" />
    <Reference Include="System.Runtime.Remoting" />
    <ProjectReference Include="..\AolaSocketHack.Contracts\AolaSocketHack.Contracts.csproj" />
    <ProjectReference Include="..\AolaSocketHack\AolaSocketHack.csproj" />
  </ItemGroup>
  <ItemGroup Condition="Exists('..\runtime\pepflashplayer.dll')">
    <Content Include="..\runtime\pepflashplayer.dll">
      <Link>runtime\pepflashplayer.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <Target Name="WarnWhenPepFlashPlayerIsMissing" BeforeTargets="Build"
          Condition="!Exists('..\runtime\pepflashplayer.dll')">
    <Warning Text="PPAPI Flash runtime is not present. The project will compile, but AolaLoader cannot start until analysis\runtime\pepflashplayer.dll is supplied locally." />
  </Target>
</Project>
