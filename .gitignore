# 根目录只发布解决方案；本文件用于保存忽略规则。
/*
!/.gitignore
!/AolaLoader.sln
!/analysis/

# analysis 只发布源码和构建配置。
/analysis/**/*
!/analysis/**/
!/analysis/**/*.cs
!/analysis/**/*.csproj
!/analysis/**/*.props
!/analysis/**/*.targets
!/analysis/**/*.config
!/analysis/**/*.manifest
!/analysis/**/packages.lock.json
!/analysis/**/*.ps1
!/analysis/**/*.py
!/analysis/**/*.as

# 本地生成目录、逆向工作区和运行资源。
/analysis/.*/
/analysis/build/
/analysis/obj/
/analysis/reverse-engineering/
/analysis/runtime/
/analysis/queue-acceleration-patches/
/analysis/skill-staging/
/analysis/skill-tests/
/analysis/AolaLoader/Resources/
[Bb]in/
[Oo]bj/
[Ee]vidence/
[Ll]ogs/
[Cc]ache/
*.verification/
__pycache__/
.vs/
.vscode/

# 本地私有配置不发布。
*.local.config
*.local.props
*.local.targets
secrets.*
credentials.*
accounts.*
